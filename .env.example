# ─────────────────────────────────────────────────────────────────────────────
# Copy this file to .env and fill in your real values.
# ─────────────────────────────────────────────────────────────────────────────

# ── Collect API ──────────────────────────────────────────────────────────────
# Get your free-trial key at https://collectapi.com → Dashboard → API Key
# The header sent to Collect API will be:  Authorization: apikey <value>
COLLECT_API_KEY=your_free_trial_key_here

# ── PostgreSQL (ETL target) ───────────────────────────────────────────────────
GAS_DB_HOST=postgres        # service name inside Docker; use localhost for external DB
GAS_DB_PORT=5432
GAS_DB_NAME=gas_db        # create a dedicated DB if preferred (see init.sql)
GAS_DB_USER=postgres        # default superuser; change if you created a custom user
GAS_DB_PASSWORD=postgres    # default password; change if you created a custom user

# ── Airflow core ─────────────────────────────────────────────────────────────
AIRFLOW_UID=50000       # run: echo $(id -u) to get your real UID on Linux/Mac
AIRFLOW__CORE__FERNET_KEY=          # leave blank; auto-generated on first start
